// storage.rules
// Cole isto em: Firebase Console > Storage > Regras
//
// - Qualquer visitante pode LER as fotos da galeria (para elas aparecerem no site).
// - Só um usuário autenticado (o admin) pode ENVIAR ou APAGAR fotos.
// - Limite de 10 MB por arquivo e só permite imagens.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /galeria/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
